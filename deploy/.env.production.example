# Production server environment (feature 009). Copy to DEPLOY_PATH on the server as .env and fill
# in real values there. Never commit the real file or share its values.

# --- Images ---
# Docker Hub account that holds chepagame-backend and chepagame-frontend
DOCKERHUB_NAMESPACE=
# Pin an image for rollback, e.g. sha-397655e; "latest" follows the last deploy.
BACKEND_TAG=latest
FRONTEND_TAG=latest
# 127.0.0.1 behind a reverse proxy on the host; 0.0.0.0 exposes the ports directly.
PUBLISH_ADDRESS=127.0.0.1

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# --- Backend (FastAPI) ---
# The host is replaced by chepagame-mongodb:27017 inside the compose network.
MONGODB_URI=mongodb://<user>:<password>@chepagame-mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_DB_NAME=chepagame
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=chepagame-api
JWT_AUDIENCE=chepagame-clients
REFRESH_TOKEN_EXPIRE_DAYS=30
# HMAC key for one-time codes and email hashes (random, at least 32 bytes)
CODE_HASH_SECRET=
# Comma-separated Google OAuth client IDs accepted as ID token audience (web, android, ios)
GOOGLE_CLIENT_IDS=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_DELIVERY=resend
ENVIRONMENT=production

# --- Contact form and anti-bot check (feature 017): only used when ENVIRONMENT=production ---
# In production the API refuses to start if any of these is missing (it names the variable).
# WhatsApp relay of the contact form (CallMeBot). CALLMEBOT_URL must be https.
CALLMEBOT_URL=
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Cloudflare Turnstile on sign-up and contact. The site key is public; the secret stays on the API.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=
# IPs whose X-Forwarded-* headers uvicorn trusts (the reverse proxy); empty trusts none.
FORWARDED_ALLOW_IPS=

# --- Web (Next.js + Auth.js) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public URL of the web app, e.g. https://chepagame.example
AUTH_URL=
NEXT_TELEMETRY_DISABLED=1

# --- Web: optional content ---
CONTACT_EMAIL=
DONATION_URL=
