# Copy this file to .env and fill in real values. Never commit .env or share its values.

# --- MongoDB (docker-compose) ---
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_PORT=27017

# --- Backend (FastAPI) ---
# From the host use directConnection=true; inside docker-compose use host "mongodb:27017".
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/?authSource=admin&directConnection=true
MONGODB_DB_NAME=chepagame
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=chepagame-api
JWT_AUDIENCE=chepagame-clients
REFRESH_TOKEN_EXPIRE_DAYS=30
# HMAC key for one-time codes and email hashes (random, at least 32 bytes)
CODE_HASH_SECRET=
# Comma-separated Google OAuth client IDs accepted as ID token audience (web, android, ios)
GOOGLE_CLIENT_IDS=
RESEND_API_KEY=
EMAIL_FROM=
# resend | console (console writes to backend/.dev-outbox/emails.jsonl; rejected in production)
EMAIL_DELIVERY=resend
# development | test | production
ENVIRONMENT=development
MONGODB_TEST_DB_NAME=chepagame_test

# --- Contact form and anti-bot check (feature 017): only used when ENVIRONMENT=production ---
# In production the API refuses to start if any of these is missing (it names the variable).
# WhatsApp relay of the contact form (CallMeBot). CALLMEBOT_URL must be https.
CALLMEBOT_URL=
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Cloudflare Turnstile on sign-up and contact. The site key is public; the secret stays on the API.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_SITE_KEY=

# --- Web (Next.js + Auth.js) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000
# Public URL of the web for canonical links, sitemap and social previews (feature 011).
# Optional: falls back to AUTH_URL.
SITE_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Backend URL used by the Next.js server (inside docker-compose: http://backend:8000/api/v1)
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1

# --- Telemetry: disabled (Principle VI, no data to third parties without opt-in) ---
NEXT_TELEMETRY_DISABLED=1
EXPO_NO_TELEMETRY=1

# --- Mobile (Expo) ---
# Android emulator: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Web origin used to build the invitation links shared from the app
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000
# Reversed iOS client ID, e.g. com.googleusercontent.apps.<id>
GOOGLE_IOS_URL_SCHEME=
# Android release signing (feature 010), read by Gradle from mobile/.env or the environment.
# STORE_FILE is an absolute path to the .jks kept OUTSIDE the repository. Never commit values,
# and never rename these with the EXPO_PUBLIC_ prefix (that would put them in the JS bundle).
ANDROID_UPLOAD_STORE_FILE=
ANDROID_UPLOAD_STORE_PASSWORD=
ANDROID_UPLOAD_KEY_ALIAS=
ANDROID_UPLOAD_KEY_PASSWORD=

# Web: public contact email shown on the Contact page (optional; empty shows a neutral text).
CONTACT_EMAIL=

# Optional https link to the donation page (feature 008). Leave empty to hide the button;
# keep EXPO_PUBLIC_DONATION_URL empty when building the App for Google Play or the App Store.
DONATION_URL=
EXPO_PUBLIC_DONATION_URL=
